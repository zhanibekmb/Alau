# Copy to .env and fill in. .env is never committed.

# Local PostgreSQL. The user and both databases are created once by hand (docs/paywall-plan.md, T0).
DATABASE_URL=postgres://alau:PASSWORD@localhost:5432/alau
# Tests only. npm run test:db wipes its tables, so never point this at real data.
DATABASE_URL_TEST=postgres://alau:PASSWORD@localhost:5432/alau_test

# Better Auth. A random secret of 32+ characters that signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# The site's address. Locally:
BETTER_AUTH_URL=http://localhost:3000

# What "Buy" does until real payments exist (docs/paywall-plan.md, D6):
#   demo      grants access at once. Only for your own computer.
#   interest  records the choice, grants nothing. For any public site. Used when unset or mistyped.
PAYMENTS_MODE=demo

# Copy to .env and fill in. .env is never committed.

# Local PostgreSQL. The user and both databases are created once by hand (docs/paywall-plan.md, T0).
DATABASE_URL=postgres://alau:PASSWORD@localhost:5432/alau
# Tests only. npm run test:db wipes its tables, so never point this at real data.
DATABASE_URL_TEST=postgres://alau:PASSWORD@localhost:5432/alau_test

# Better Auth. A random secret of 32+ characters that signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# The site's address. Locally:
BETTER_AUTH_URL=http://localhost:3000

# What "Buy" does until real payments exist (docs/paywall-plan.md, D6):
#   demo      grants access at once. Only for your own computer.
#   interest  records the choice, grants nothing. For any public site. Used when unset or mistyped.
#   transfer  records the choice and shows how to pay by Kaspi transfer (TRANSFER_* below);
#             you give access by hand on /admin/paywall when the money arrives.
PAYMENTS_MODE=demo

# Who may open /admin/paywall: emails separated by commas. Empty means nobody.
ADMIN_EMAILS=admin@alau.com

# Password reset emails through Brevo (free: 300 emails a day). Create an API key at
# app.brevo.com → SMTP & API → API keys, and verify the sender address there.
# Without these, on your own computer the reset link is printed in the terminal.
BREVO_API_KEY=
MAIL_FROM=

# Payment by transfer (PAYMENTS_MODE=transfer). Shown only to signed-in readers who chose a tariff.
# TRANSFER_KASPI: phone or card number. TRANSFER_NAME: name as Kaspi shows it.
# TRANSFER_CONTACT: where readers send the receipt, https://t.me/…, https://wa.me/… or an email.
TRANSFER_KASPI=
TRANSFER_NAME=
TRANSFER_CONTACT=

# Copy to .env and fill in. Never commit .env: it holds passwords.
# On Vercel, add the same keys in Project → Settings → Environment Variables (Production).

# PostgreSQL. Locally: postgres://alau:PASSWORD@localhost:5432/alau
# On Vercel: the pooled connection string of the cloud database (Neon: the host has "-pooler"),
# with ?sslmode=require at the end.
DATABASE_URL=
# Local tests only (npm run test:db). The database name must end in _test: tests wipe it.
DATABASE_URL_TEST=

# Better Auth. SECRET: a random string of 32+ characters, different for each server
# (for example: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
BETTER_AUTH_SECRET=
# The site address without a trailing slash: http://localhost:3000 or https://your-domain
BETTER_AUTH_URL=

# Google sign-in (Google Cloud Console → Clients). Without both keys the Google button is hidden.
# Redirect URI to allow in Google Cloud: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Brevo): confirmation and password reset links. Without them email sign-up cannot be
# confirmed, so only Google sign-in works.
BREVO_API_KEY=
MAIL_FROM=

# Who may open /admin/paywall: emails separated by commas.
ADMIN_EMAILS=

# Paywall: interest (collect choices, unlock nothing), demo (unlock without paying) or transfer
# (Kaspi transfer, access given by hand on /admin/paywall).
PAYMENTS_MODE=interest
# Only for PAYMENTS_MODE=transfer: where to send money and the receipt.
TRANSFER_KASPI=
TRANSFER_NAME=
TRANSFER_CONTACT=
